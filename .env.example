# Publisher-owned MULTITENANT app (AzureADMultipleOrgs).
# Configure once before building; customer companies do not supply IDs.
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional: public absolute auth.html URL (default: beside index.html)
VITE_REDIRECT_URI=https://localhost:3002/auth.html
