{
  "name": "outlook-hierarchy-address-book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest": "node scripts/manifest.mjs",
    "validate:manifest": "office-addin-manifest validate manifest.xml",
    "cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-cert.ps1"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fs-extra": "^11.4.1",
    "office-addin-manifest": "^3.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
